{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "resourceTypes": [
      "Microsoft.Compute/virtualMachines"
    ],
    "basics": [
      {
        "name": "vmName",
        "type": "Microsoft.Common.TextBox",
        "label": "VM Name",
        "defaultValue": "vm-opnsense",
        "toolTip": "Name of the OPNsense VM. All related resources will be named from this.",
        "constraints": {
          "required": true,
          "regex": "^[a-zA-Z0-9-]{1,64}$",
          "validationMessage": "Only alphanumeric characters and hyphens, max 64 characters."
        }
      },
      {
        "name": "imageResourceId",
        "type": "Microsoft.Common.TextBox",
        "label": "Image Resource ID",
        "placeholder": "/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.Compute/galleries/<gallery>/images/<definition>/versions/<version>",
        "toolTip": "Full resource ID of the OPNsense image version in the MSP Azure Compute Gallery.",
        "constraints": {
          "required": true,
          "regex": "^/subscriptions/.+/providers/Microsoft.Compute/galleries/.+/images/.+/versions/.+$",
          "validationMessage": "Must be a valid Azure Compute Gallery image version resource ID."
        }
      },
      {
        "name": "vmSize",
        "type": "Microsoft.Common.DropDown",
        "label": "VM Size",
        "defaultValue": "B2als_v2 (2 vCPU, 4 GB RAM) - Recommended",
        "toolTip": "Size of the VM. B2als_v2 is recommended for VPN-only workloads.",
        "constraints": {
          "required": true,
          "allowedValues": [
            { "label": "B2als_v2 (2 vCPU, 4 GB RAM) - Recommended", "value": "Standard_B2als_v2" },
            { "label": "B2as_v2 (2 vCPU, 8 GB RAM)", "value": "Standard_B2as_v2" },
            { "label": "B2ts_v2 (2 vCPU, 1 GB RAM) - Minimal", "value": "Standard_B2ts_v2" },
            { "label": "B4als_v2 (4 vCPU, 8 GB RAM)", "value": "Standard_B4als_v2" },
            { "label": "B4as_v2 (4 vCPU, 16 GB RAM)", "value": "Standard_B4as_v2" }
          ]
        }
      }
    ],
    "steps": [
      {
        "name": "credentials",
        "label": "Credentials",
        "elements": [
          {
            "name": "credentialsInfo",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "This password will be set as the root account password on the OPNsense VM via a post-deployment script."
            }
          },
          {
            "name": "rootPassword",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "Root Password",
              "confirmPassword": "Confirm Root Password"
            },
            "toolTip": "Password to set for the root account on the OPNsense VM.",
            "constraints": {
              "required": true,
              "regex": "^(?=.*[A-Z])(?=.*[a-z])(?=.*[0-9])(?=.*[^A-Za-z0-9]).{12,}$",
              "validationMessage": "Minimum 12 characters, must include uppercase, lowercase, number and special character."
            },
            "options": {
              "hideConfirmation": false
            }
          }
        ]
      },
      {
        "name": "networking",
        "label": "Networking",
        "elements": [
          {
            "name": "vnetSelector",
            "type": "Microsoft.Network.VirtualNetworkCombo",
            "label": {
              "virtualNetwork": "Virtual Network",
              "subnets": "OPNsense NIC Subnets"
            },
            "toolTip": {
              "virtualNetwork": "Select the existing VNet for this deployment.",
              "subnets": "Select the WAN and LAN subnets for the OPNsense NICs."
            },
            "defaultValue": {
              "name": "",
              "addressPrefixSize": "/16"
            },
            "constraints": {
              "minAddressPrefixSize": "/29"
            },
            "options": {
              "hideExisting": false
            },
            "subnets": {
              "wanSubnet": {
                "label": "WAN Subnet",
                "defaultValue": {
                  "name": "snet-opnsense-wan",
                  "addressPrefixSize": "/29"
                },
                "constraints": {
                  "minAddressPrefixSize": "/29"
                }
              },
              "lanSubnet": {
                "label": "LAN Subnet",
                "defaultValue": {
                  "name": "snet-opnsense-lan",
                  "addressPrefixSize": "/29"
                },
                "constraints": {
                  "minAddressPrefixSize": "/29"
                }
              }
            }
          },
          {
            "name": "subnetApi",
            "type": "Microsoft.Solutions.ArmApiControl",
            "request": {
              "method": "GET",
              "path": "[concat('/subscriptions/', steps('networking').vnetSelector.subscriptionId, '/resourceGroups/', steps('networking').vnetSelector.resourceGroup, '/providers/Microsoft.Network/virtualNetworks/', steps('networking').vnetSelector.name, '/subnets?api-version=2023-05-01')]"
            }
          },
          {
            "name": "routeTableInfo",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "Route Table — Remote Site Routing (Optional): If you have on-premises or remote site subnets that need to be reachable from Azure through the OPNsense VM, enter them below. A route table will be created and associated with the Azure subnets you select, routing that traffic via the OPNsense LAN NIC. Leave both fields empty to skip route table creation."
            }
          },
          {
            "name": "remoteSubnets",
            "type": "Microsoft.Common.EditableGrid",
            "label": "Remote Site Subnets",
            "toolTip": "On-premises or remote site subnets to route via the OPNsense LAN NIC. Enter one CIDR per row.",
            "ariaLabel": "Remote site subnets",
            "constraints": {
              "width": "Full",
              "rows": {
                "count": {
                  "min": 0,
                  "max": 50
                }
              },
              "columns": [
                {
                  "id": "subnet",
                  "header": "Remote Subnet (CIDR)",
                  "width": "1fr",
                  "element": {
                    "type": "Microsoft.Common.TextBox",
                    "placeholder": "192.168.1.0/24",
                    "constraints": {
                      "required": true,
                      "regex": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$",
                      "validationMessage": "Must be a valid CIDR notation subnet."
                    }
                  }
                }
              ]
            }
          },
          {
            "name": "routeTableSubnets",
            "type": "Microsoft.Common.DropDown",
            "label": "Azure Subnets to Apply Route Table To",
            "toolTip": "Select the subnets within the VNet that should route remote site traffic via OPNsense. Only relevant if remote site subnets are specified above.",
            "multiLine": true,
            "multiselect": true,
            "selectAll": false,
            "constraints": {
              "allowedValues": "[map(steps('networking').subnetApi.value, (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.name, '\"}')))]"
            }
          }
        ]
      },
      {
        "name": "storage",
        "label": "Storage",
        "elements": [
          {
            "name": "osDiskSku",
            "type": "Microsoft.Common.DropDown",
            "label": "OS Disk SKU",
            "defaultValue": "Standard SSD LRS - Recommended",
            "toolTip": "Storage tier for the OS disk.",
            "constraints": {
              "required": true,
              "allowedValues": [
                { "label": "Standard HDD LRS - Lowest cost", "value": "Standard_LRS" },
                { "label": "Standard SSD LRS - Recommended", "value": "StandardSSD_LRS" },
                { "label": "Premium SSD LRS", "value": "Premium_LRS" }
              ]
            }
          }
        ]
      }
    ],
    "outputs": {
      "vmName": "[basics('vmName')]",
      "imageResourceId": "[basics('imageResourceId')]",
      "vmSize": "[basics('vmSize')]",
      "rootPassword": "[steps('credentials').rootPassword]",
      "vnetResourceGroup": "[steps('networking').vnetSelector.resourceGroup]",
      "vnetName": "[steps('networking').vnetSelector.name]",
      "wanSubnetName": "[steps('networking').vnetSelector.subnets.wanSubnet.name]",
      "lanSubnetName": "[steps('networking').vnetSelector.subnets.lanSubnet.name]",
      "remoteSubnets": "[map(steps('networking').remoteSubnets, (item) => item.subnet)]",
      "routeTableSubnetNames": "[steps('networking').routeTableSubnets]",
      "osDiskSku": "[steps('storage').osDiskSku]"
    }
  }
}